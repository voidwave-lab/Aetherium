{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Aetherium",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true,
        "exists": true,
        "scope": [
          "$AUDIO/*",
          "$AUDIO/**",
          "$DESKTOP/*",
          "$DESKTOP/**",
          "$DOWNLOAD/*",
          "$DOWNLOAD/**",
          "$DOCUMENT/*",
          "$DOCUMENT/**",
          "$APPDATA/**",
          "$APPCONFIG/**",
          "$LOCALDATA/**"
        ]
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true
      },
      "path": {
        "all": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "setTitle": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Music",
      "copyright": "Copyright (C) 2026 Voidwave Lab. Licensed under the GNU General Public License v3.0 (GPL-3.0-or-later).",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "io.voidwavelab.aetherium",
      "longDescription": "Aetherium is an open-source, cross-platform generative ambient music and receptive music therapy desktop sanctuary.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "Generative Soundscape & Receptive Music Therapy",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "Aetherium — Generative Soundscape & Receptive Therapy",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ]
  }
}
